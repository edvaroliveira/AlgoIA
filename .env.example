# Formato: CHAVE=valor. Comentario no fim da linha e aceito quando o "#" vem
# depois de espaco (CHAVE=valor  # comentario). "#" colado ao texto faz parte
# do valor (ex.: Senha#123). Valor com " #" de verdade deve ficar entre aspas.
APP_NAME="IAProg"
APP_ENV=production
APP_URL=https://edvar.pro.br/algoia
APP_DEBUG=false

DB_HOST=localhost
DB_DATABASE=seu_banco
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o
# Timeout por chamada (segundos) e numero de tentativas antes de falhar o job.
# Padroes: 30s / 3 tentativas.
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Tentativas de correcao por job antes de esgotar (padrao 3) e minutos parado
# em "processing"/"queued" antes de ser considerado travado (padrao 15).
GRADING_JOB_MAX_ATTEMPTS=3
GRADING_JOB_STALE_MINUTES=15

# IPs/CIDRs dos proxies confiaveis (separados por virgula). Vazio = ignora
# X-Forwarded-For/CF-Connecting-IP e usa apenas REMOTE_ADDR na auditoria.
# Preencha SOMENTE com os IPs do seu proxy/CDN — qualquer cliente pode forjar
# esses cabecalhos e escolher o IP gravado em audit_logs.
TRUSTED_PROXIES=

# Avisos por e-mail (worker bin/send_notification_emails.php no cron).
# MAIL_DRIVER=smtp (recomendado): envia pela caixa de e-mail do dominio, que ja
# esta autorizada no SPF (ex.: Titan: smtp.titan.email, 465, ssl).
# MAIL_DRIVER=mail usa o mail() do servidor web, que costuma falhar no SPF.
# Sem MAIL_FROM valido o worker sai com codigo 2 e nao envia nada.
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@seu-dominio
MAIL_FROM_NAME="AlgoIA"
MAIL_SMTP_HOST=smtp.titan.email
MAIL_SMTP_PORT=465
# ssl (porta 465) ou tls (porta 587, STARTTLS)
MAIL_SMTP_ENCRYPTION=ssl
MAIL_SMTP_USER=no-reply@seu-dominio
MAIL_SMTP_PASSWORD=defina_no_servidor

SEED_TEACHER_NAME="Professor Admin"
SEED_TEACHER_EMAIL=admin@seudominio.com.br
SEED_TEACHER_PASSWORD=defina_uma_senha_forte

# Admin inicial (php database/seeds/002_seed_admin.php). Sem senha padrão:
# o seed recusa valor vazio, este placeholder ou senha fraca.
SEED_ADMIN_NAME="Administrador do Sistema"
SEED_ADMIN_EMAIL=admin@seu-dominio
SEED_ADMIN_PASSWORD=defina_uma_senha_forte
