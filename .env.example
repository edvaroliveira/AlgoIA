APP_NAME="IAProg"
APP_ENV=production
APP_URL=https://edvar.pro.br/algoia
APP_DEBUG=false

DB_HOST=localhost
DB_DATABASE=seu_banco
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o
# Timeout por chamada (segundos) e numero de tentativas antes de falhar o job.
# Padroes: 30s / 3 tentativas.
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Tentativas de correcao por job antes de esgotar (padrao 3) e minutos parado
# em "processing"/"queued" antes de ser considerado travado (padrao 15).
GRADING_JOB_MAX_ATTEMPTS=3
GRADING_JOB_STALE_MINUTES=15

# IPs/CIDRs dos proxies confiaveis (separados por virgula). Vazio = ignora
# X-Forwarded-For/CF-Connecting-IP e usa apenas REMOTE_ADDR na auditoria.
# Preencha SOMENTE com os IPs do seu proxy/CDN — qualquer cliente pode forjar
# esses cabecalhos e escolher o IP gravado em audit_logs.
TRUSTED_PROXIES=

SEED_TEACHER_NAME="Professor Admin"
SEED_TEACHER_EMAIL=admin@seudominio.com.br
SEED_TEACHER_PASSWORD=TrocaEsta123!
